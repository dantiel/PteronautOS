.mui-panel.mui--text-title
  %span.panel-icon.icon--symbols.icon--symbols--backup
  = self._t('backup.title')
.mui-panel
  .mui--text-title= self._t('backup.export_title')
  %p{style: "color:#888;font-size:13px;"}= self._t('backup.export_text')
  %button{type: "button", @click: self._export, .disabled: self._busy(), style: "padding:8px 16px;cursor:pointer;background:#d4a017;color:#111;border:none;border-radius:4px;font-weight:600;"}= self._t('backup.export_btn')
.mui-panel
  .mui--text-title= self._t('backup.import_title')
  %p{style: "color:#888;font-size:13px;"}= self._t('backup.import_text')
  %input{type: "file", accept: "application/json,.json", @change: self._importFile, .disabled: self._busy(), style: "color:#ccc;font-size:13px;"}
- if self.message
  %div{style: "margin-top:12px;font-size:13px;" + self._statusStyle()}= self.message