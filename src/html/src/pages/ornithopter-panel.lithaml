.mui-panel.mui--text-title
  %span.panel-icon.icon--symbols.icon--symbols--ornithopter
  = self._t('ornithopter.panel.title')

- unless self.stateLoaded
  %div{style: "color:#d4a017;font-size:13px;margin:8px 0;"} Loading configuration — fields unlock once state arrives…

.mui-panel
  .mui--text-title= self._t('ornithopter.kernel.title')
  %table.mui-table.mui-table--bordered
    %tbody
      %tr
        %td
          %b= self._t('ornithopter.kernel.model_name')
          %br
          %small{style: "color:#888;"}= self._t('ornithopter.kernel.model_name_desc')
        %td
          %input{type: "text", maxlength: "32", placeholder: self._t('ornithopter.kernel.model_name_placeholder'), .value: self.modelName, @input: self._onModelName, @change: self._onModelNameCommit, .disabled: self._uiLocked(), style: "width:100%;max-width:320px;padding:6px 8px;font-family:inherit;font-size:14px;background:#111;color:#ccc;border:1px solid #333;border-radius:4px;"}
      %tr
        %td
          %b= self._t('ornithopter.kernel.kernel')
        %td
          %select{@change: self._onKernel, .disabled: self._uiLocked(), style: "width:100%;padding:8px 10px;font-family:inherit;font-size:14px;background:#111;color:#ccc;border:1px solid #333;border-radius:4px;cursor:pointer;"}
            - for k of [{v:'servo',l:self._t('ornithopter.kernel.servo_drive')},{v:'gearbox',l:self._t('ornithopter.kernel.gearbox')}]
              - if k.v == self.kernel
                %option{value: k.v, selected: ""}= k.l
              - else
                %option{value: k.v}= k.l
      %tr
        %td
          %b= self._t('ornithopter.kernel.mixer')
        %td
          %select{@change: self._onMixer, .disabled: self._uiLocked(), style: "width:100%;padding:8px 10px;font-family:inherit;font-size:14px;background:#111;color:#ccc;border:1px solid #333;border-radius:4px;cursor:pointer;"}
            - for p of self._profilesForKernel()
              - if p.id == self.profileId
                %option{value: p.id, selected: ""}= "#{p.label} — #{p.servos} servos"
              - else
                %option{value: p.id}= "#{p.label} — #{p.servos} servos"
      %tr
        %td
          %b= self._t('ornithopter.kernel.servo_count')
        %td= self._servoCount()
      %tr
        %td
          %b= self._t('ornithopter.kernel.servo_map')
        %td
          %small= self._servoMapStr()
      %tr
        %td
          %b= self._t('ornithopter.kernel.servo_speed')
          %br
          %small{style: "color:#888;"}= self._t('ornithopter.kernel.servo_speed_desc')
        %td
          %div{style: "display:flex;align-items:center;gap:6px;flex-wrap:wrap;"}
            %button{type: "button", @click: self._nudge('servoSpeed', -5), .disabled: self._uiLocked(), style: "padding:4px 10px;font-size:16px;line-height:1;cursor:pointer;background:#1a1a1a;color:#ccc;border:1px solid #333;border-radius:4px;"} -
            %input{type: "number", min: "25", max: "250", step: "1", .value: self.servoSpeed, @input: self._onNumberInput('servoSpeed'), @change: self._onNumberCommit('servoSpeed'), @focus: self._onFieldFocus, @blur: self._onFieldBlur, .disabled: self._uiLocked(), style: "width:90px;padding:6px 8px;font-family:inherit;font-size:14px;background:#111;color:#ccc;border:1px solid #333;border-radius:4px;"}
            %button{type: "button", @click: self._nudge('servoSpeed', 5), .disabled: self._uiLocked(), style: "padding:4px 10px;font-size:16px;line-height:1;cursor:pointer;background:#1a1a1a;color:#ccc;border:1px solid #333;border-radius:4px;"} +
            %span.value= self._servoSpeedLabel()
          %select{@change: self._onServoPreset, .disabled: self._uiLocked(), style: "width:100%;max-width:300px;padding:6px 8px;font-family:inherit;font-size:13px;background:#111;color:#ccc;border:1px solid #333;border-radius:4px;cursor:pointer;margin-top:6px;"}
            %option{value: ""} — Servo presets (speed + pulse) —
            - for pr, idx in self._servoPresets()
              %option{value: idx}= pr.label
      %tr
        %td
          %b= self._t('ornithopter.kernel.base_freq')
          %br
          %small{style: "color:#888;"}= self._t('ornithopter.kernel.base_freq_desc')
        %td
          %input{type: "range", min: "10", max: "200", step: "5", .value: self.flapBaseFreq, @input: self._onSlider('flapBaseFreq'), @change: self._onSliderCommit, .disabled: self._uiLocked(), style: "width:200px;"}
          %span.value= self._flapBaseFreqLabel()
      %tr
        %td
          %b= self._t('ornithopter.kernel.servo_min_us')
          %br
          %small{style: "color:#888;"}= self._t('ornithopter.kernel.servo_pulse_desc')
        %td
          %input{type: "number", min: "500", max: "1490", step: "1", .value: self.servoMinUs, @input: self._onNumberInput('servoMinUs'), @change: self._onNumberCommit('servoMinUs'), @focus: self._onFieldFocus, @blur: self._onFieldBlur, .disabled: self._uiLocked(), style: "width:100px;padding:6px 8px;font-family:inherit;font-size:14px;background:#111;color:#ccc;border:1px solid #333;border-radius:4px;"}
          |  µs
      %tr
        %td
          %b= self._t('ornithopter.kernel.servo_max_us')
        %td
          %input{type: "number", min: "1510", max: "2500", step: "1", .value: self.servoMaxUs, @input: self._onNumberInput('servoMaxUs'), @change: self._onNumberCommit('servoMaxUs'), @focus: self._onFieldFocus, @blur: self._onFieldBlur, .disabled: self._uiLocked(), style: "width:100px;padding:6px 8px;font-family:inherit;font-size:14px;background:#111;color:#ccc;border:1px solid #333;border-radius:4px;"}
          |  µs

.mui-panel
  .mui--text-title= self._t('ornithopter.kernel.trim_title')
  %small{style: "color:#888;"}= self._t('ornithopter.kernel.trim_desc')
  %table.mui-table.mui-table--bordered
    %tbody
      - for t of self._servoTrimList()
        %tr
          %td
            %b= t.label
          %td
            %input{type: "number", min: "-300", max: "300", step: "1", .value: self[t.prop], @input: self._onNumberInput(t.prop), @change: self._onNumberCommit(t.prop), @focus: self._onFieldFocus, @blur: self._onFieldBlur, .disabled: self._uiLocked(), style: "width:100px;padding:6px 8px;font-family:inherit;font-size:14px;background:#111;color:#ccc;border:1px solid #333;border-radius:4px;"}
            %span.value= self[t.prop]
            |  µs

.mui-panel
  .mui--text-title= self._t('ornithopter.mixing.title')
  %br
  %small{style: "color:#888;"}= self._t('ornithopter.mixing.kernel_hint')
  %table.mui-table.mui-table--bordered
    %tbody
  - if self._hasRudder()
    %table.mui-table.mui-table--bordered
      %tbody
        %tr
          %td
            %b= self._t('ornithopter.mixing.rudder_yaw')
            %br
            %small{style: "color:#888;"}= self._t('ornithopter.mixing.rudder_yaw_desc')
          %td
            %input{type: "range", min: "0", max: "100", .value: self.rudderYawWeight, @input: self._onSlider('rudderYawWeight'), @change: self._onSliderCommit, .disabled: self._uiLocked(), style: "width:200px;"}
            %span.value= self.rudderYawWeight
            %
        %tr
          %td
            %b= self._t('ornithopter.mixing.rudder_roll')
            %br
            %small{style: "color:#888;"}= self._t('ornithopter.mixing.rudder_roll_desc')
          %td
            %input{type: "range", min: "0", max: "100", .value: self.rudderRollWeight, @input: self._onSlider('rudderRollWeight'), @change: self._onSliderCommit, .disabled: self._uiLocked(), style: "width:200px;"}
            %span.value= self.rudderRollWeight
            %
  - if self._hasVtail()
    %table.mui-table.mui-table--bordered
      %tbody
        %tr
          %td
            %b= self._t('ornithopter.mixing.elevon_scale')
            %br
            %small{style: "color:#888;"}= self._t('ornithopter.mixing.elevon_scale_desc')
          %td
            %input{type: "range", min: "0", max: "100", .value: self.elevonScale, @input: self._onSlider('elevonScale'), @change: self._onSliderCommit, .disabled: self._uiLocked(), style: "width:200px;"}
            %span.value= self.elevonScale
            %
  - if self._hasMotor()
    %table.mui-table.mui-table--bordered
      %tbody
        %tr
          %td
            %b= self._t('ornithopter.mixing.motor_min')
            %br
            %small{style: "color:#888;"}= self._t('ornithopter.mixing.motor_min_desc')
          %td
            %input{type: "range", min: "900", max: "1200", .value: self.motorMinUs, @input: self._onSlider('motorMinUs'), @change: self._onSliderCommit, .disabled: self._uiLocked(), style: "width:200px;"}
            %span.value= self.motorMinUs
            |  µs
        %tr
          %td
            %b= self._t('ornithopter.mixing.motor_max')
          %td
            %input{type: "range", min: "1800", max: "2100", .value: self.motorMaxUs, @input: self._onSlider('motorMaxUs'), @change: self._onSliderCommit, .disabled: self._uiLocked(), style: "width:200px;"}
            %span.value= self.motorMaxUs
            |  µs

- if self._isGearboxProfile()
  .mui-panel
    .mui--text-title
      = self._t('ornithopter.glide.title')
      %label{style: "cursor:pointer;"}
        %input{type: "checkbox", checked: self.glideMode, @change: self._onCheck('glideMode'), .disabled: self._uiLocked(), style: "width:18px;height:18px;accent-color:#ccc;margin-left:12px;vertical-align:middle;"}
        %span{style: "color:#888;margin-left:6px;font-size:13px;vertical-align:middle;"}= self.glideMode ? self._t('ornithopter.glide.enabled') : self._t('ornithopter.glide.disabled')
    %small{style: "color:#888;"}= self._t('ornithopter.glide.gearbox_desc')
    - if self.glideMode
      %table.mui-table.mui-table--bordered
        %tbody
          %tr
            %td
              %b= self._t('ornithopter.glide.hall_sensor_pin')
              %br
              %small{style: "color:#888;"}= self._t('ornithopter.glide.hall_sensor_pin_desc')
            %td
              %select{@change: self._onSelect('hallSensorPin'), .disabled: self._uiLocked(), style: "width:100%;padding:8px 10px;font-family:inherit;font-size:14px;background:#111;color:#ccc;border:1px solid #333;border-radius:4px;cursor:pointer;"}
                - for pin of self._freeHallPins()
                  - if pin == self.hallSensorPin
                    %option{value: pin, selected: ""}= "GPIO#{pin}"
                  - else
                    %option{value: pin}= "GPIO#{pin}"
          %tr
            %td
              %b= self._t('ornithopter.glide.ratchet_throttle')
              %br
              %small{style: "color:#888;"}= self._t('ornithopter.glide.ratchet_throttle_desc')
            %td
              %input{type: "range", min: "0", max: "100", .value: self.ratchetThrottlePct, @input: self._onSlider('ratchetThrottlePct'), @change: self._onSliderCommit, .disabled: self._uiLocked(), style: "width:200px;"}
              %span.value= self.ratchetThrottlePct
              %
          %tr
            %td
              %b= self._t('ornithopter.glide.ratchet_timeout')
              %br
              %small{style: "color:#888;"}= self._t('ornithopter.glide.ratchet_timeout_desc')
            %td
              %input{type: "range", min: "100", max: "2000", step: "50", .value: self.ratchetTimeoutMs, @input: self._onSlider('ratchetTimeoutMs'), @change: self._onSliderCommit, .disabled: self._uiLocked(), style: "width:200px;"}
              %span.value= self.ratchetTimeoutMs
              |  ms

.mui-panel.ptero-centered
  %button.ptero-btn{@click: self._saveConfig, .disabled: self._uiLocked()}= self._t('ornithopter.save')
  - if self._saveStateText().length
    %div{style: "#{self._saveStateStyle()}font-size:13px;margin-top:6px;"}= self._saveStateText()
  %br
  %small.ptero-muted= self._t('ornithopter.save_hint')