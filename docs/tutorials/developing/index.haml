!!!
%html{lang: lang, dir: dir}
  %head
    %meta{charset: "utf-8"}
    %meta{name: "viewport", content: "width=device-width, initial-scale=1"}
    %title!= devt_title
    %link{rel: "preconnect", href: "https://fonts.googleapis.com"}
    %link{rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: true}
    %link{rel: "stylesheet", href: "https://fonts.googleapis.com/css2?family=Turret+Road:wght@200;300;400;500;700;800&family=Noto+Naskh+Arabic:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@200;300;400;500;700&display=swap"}
    %link{rel: "stylesheet", href: "#{asset_prefix}assets/css/style.css"}
  %body.sub-page
    %nav.sub-nav
      .nav-progressive-blur{"aria-hidden": "true"}
        %span
        %span
        %span
        %span
      %button.nav-scroll-top{type: "button", onclick: "window.scrollTo({top:0,behavior:'smooth'})", "aria-label": subnav_scroll, title: subnav_scroll} ↑
      %a.home-link{href: "#{asset_prefix}#{lang_dir}", title: subnav_home}
        %span.pteronaut> PTERONAUT
        %span.os OS
      %a{href: "#{asset_prefix}#{lang_dir}tutorials/", class: "active"}!= nav_tutorials
      %a{href: "#{asset_prefix}#{lang_dir}hardware/"}!= nav_hardware
      %a{href: "#{asset_prefix}#{lang_dir}documentation/"}!= nav_documentation
    %main.sub-main
      .sub-content
        %p.tutorial-number!= devt_number
        %h1!= devt_h1
        %p.sub-lead!= devt_lead
        %p!= devt_p1
        %p
          != devt_p2_a
          %a{href: "#{asset_prefix}#{lang_dir}tutorials/flash-script/"}!= devt_p2_link
          != devt_p2_b

        %h2!= devt_h2_toolchain
        != devt_toolchain_p_markdown
        %table
          %tr
            %th!= devt_th_req
            %th!= devt_th_ver
          %tr
            %td!= devt_req_pio
            %td!= devt_req_pio_v
          %tr
            %td!= devt_req_node
            %td!= devt_req_node_v
          %tr
            %td!= devt_req_git
            %td!= devt_req_git_v
          %tr
            %td!= devt_req_py
            %td!= devt_req_py_v
        %p!= devt_verify_p
        %pre
          %code
            :preserve
              pio --version
              node --version   # should print v20.x
        %aside.flasher-callout
          %p.flasher-callout-text!= devt_warn

        %h2!= devt_h2_windows
        %p!= devt_windows_install_p
        %pre
          %code
            :preserve
              winget install --id Git.Git -e
              winget install --id OpenJS.NodeJS.LTS -e
              winget install --id Python.Python.3.12 -e
              python -m pip install -U platformio
        != devt_windows_bash_p_markdown
        %p!= devt_windows_alt_p

        %h2!= devt_h2_get
        %pre
          %code
            :preserve
              git clone https://github.com/dantiel/PteronautOS.git
              cd PteronautOS
        %p!= devt_get_p

        %h2!= devt_h2_layout
        %table
          %tr
            %th!= devt_layout_th_path
            %th!= devt_layout_th_purpose
          %tr
            %td
              %code src/platformio.ini
            %td!= devt_layout_platformio
          %tr
            %td
              %code src/targets/pteronautos-rx.ini
            %td!= devt_layout_targets
          %tr
            %td
              %code src/targets/common.ini
            %td!= devt_layout_common
          %tr
            %td
              %code src/lib/Ornithopter/
            %td!= devt_layout_orni
          %tr
            %td
              %code src/lib/Zephyrus/
            %td!= devt_layout_zeph
          %tr
            %td
              %code src/lib/ServoOutput/
            %td!= devt_layout_servo
          %tr
            %td
              %code src/lib/WIFI/
            %td!= devt_layout_wifi
          %tr
            %td
              %code src/lib/Mushin/
            %td!= devt_layout_mushin
          %tr
            %td
              %code src/html/
            %td!= devt_layout_html
          %tr
            %td
              %code src/python/
            %td!= devt_layout_python
          %tr
            %td
              %code src/src/rx_main.cpp
            %td!= devt_layout_rxmain
          %tr
            %td
              %code src/user_defines.txt
            %td!= devt_layout_userdef
          %tr
            %td
              %code src/user_defines.txt.example
            %td!= devt_layout_userdefex
          %tr
            %td
              %code scripts/flash.sh
            %td!= devt_layout_flashsh
          %tr
            %td
              %code hermetic.manifest.md
            %td!= devt_layout_manifest

        %h2!= devt_h2_buildorder
        %p!= devt_buildorder_p
        %table
          %tr
            %th!= devt_buildorder_th_step
            %th!= devt_buildorder_th_output
          %tr
            %td!= devt_buildorder_1
            %td
              %code src/html/headers/web-pteronautos-rx-8285.h
          %tr
            %td!= devt_buildorder_2
            %td
              %code src/.pio/build/&lt;env&gt;/firmware.bin
        %p!= devt_buildorder_note

        %h3!= devt_h3_webui
        %pre
          %code
            :preserve
              cd src/html
              nvm use 20
              I18N_LOCALES=en npm run build:pteronautos
        %p!= devt_webui_lang_p
        %pre
          %code
            :preserve
              I18N_LOCALES=en        npm run build:pteronautos   # English only (smallest)
              I18N_LOCALES=en,de     npm run build:pteronautos   # English + German
              I18N_LOCALES=all       npm run build:pteronautos   # all 11 languages

        %h3!= devt_h3_firmware
        %pre
          %code
            :preserve
              cd ../.. && pio run -d src -e PteronautOS_ESP8285_2400_RX
        %p!= devt_firmware_p

        %h2!= devt_h2_envs
        %p!= devt_envs_p
        %table
          %tr
            %th!= devt_envs_th_env
            %th!= devt_envs_th_desc
          %tr
            %td
              %code PteronautOS_ESP8285_2400_RX
            %td!= devt_env_default
          %tr
            %td
              %code PteronautOS_ESP8285_2400_RX_HORIZON
            %td!= devt_env_horizon
          %tr
            %td
              %code PteronautOS_ESP8285_2400_RX_PWMP5
            %td!= devt_env_pwmp5
          %tr
            %td
              %code PteronautOS_ESP8285_2400_RX_PWMP5_HORIZON
            %td!= devt_env_pwmp5_horizon
          %tr
            %td
              %code PteronautOS_ESP8285_2400_RX_BARO
            %td!= devt_env_baro
          %tr
            %td
              %code PteronautOS_ESP8285_2400_RX_GEARBOX
            %td!= devt_env_gearbox
          %tr
            %td
              %code PteronautOS_ESP8285_EP2_2400_RX
            %td!= devt_env_ep2
          %tr
            %td
              %code PteronautOS_ESP8285_EP2_2400_RX_PWM
            %td!= devt_env_ep2pwm
        %p!= devt_envs_note
        %pre
          %code
            :preserve
              pio run -e PteronautOS_ESP8285_2400_RX
        %p!= devt_envs_horizon_note

        %h2!= devt_h2_config
        %p!= devt_config_intro

        %h3!= devt_h3_userdef
        %p!= devt_userdef_p
        %pre
          %code
            :preserve
              cp src/user_defines.txt.example src/user_defines.txt
        %p!= devt_userdef_minimal
        %pre
          %code
            :preserve
              -DAUTO_WIFI_ON_INTERVAL=30
              -DLOCK_ON_FIRST_CONNECTION
              -DMIXER_PROFILE=1
              -DZEPHYRUS_ENABLED=1
              -DZEPHYR_IMU=ZEPHYR_IMU_MPU6050
              -DMY_BINDING_PHRASE="my-binding-phrase"
        %p!= devt_userdef_note

        %h3!= devt_h3_flags
        %pre
          %code
            :preserve
              PLATFORMIO_BUILD_FLAGS="-DRegulatory_Domain_EU_CE_2400" \\
                pio run -e PteronautOS_ESP8285_2400_RX
        %p!= devt_flags_note

        %h3!= devt_h3_headers
        %p!= devt_headers_p
        %ul
          %li
            %code src/lib/Ornithopter/OrnithopterConfig.h
            != devt_headers_orni
          %li
            %code src/lib/Zephyrus/ZephyrusConfig.h
            != devt_headers_zeph

        %h2!= devt_h2_where
        %table
          %tr
            %th!= devt_where_th_action
            %th!= devt_where_th_edit
          %tr
            %td!= devt_where_mixer
            %td
              %code src/lib/Ornithopter/OrnithopterGearbox.cpp
              %span!= devt_where_mixer_alt
          %tr
            %td!= devt_where_gyro
            %td
              %code src/lib/Zephyrus/Zephyrus.cpp
          %tr
            %td!= devt_where_webui
            %td
              %code src/html/src/pages/*.coffee
              %span!= devt_where_webui_alt
          %tr
            %td!= devt_where_pwm
            %td
              %code src/lib/ServoOutput/devServoOutput.cpp
          %tr
            %td!= devt_where_rx
            %td
              %code src/src/rx_main.cpp
        %p!= devt_where_note

        %h2!= devt_h2_rules
        %p!= devt_rules_p
        %ul
          %li!= devt_rule_malloc
          %li!= devt_rule_delay
          %li!= devt_rule_loop
          %li!= devt_rule_failsafe
          %li!= devt_rule_budget
          %li!= devt_rule_gps
        %p!= devt_rules_note

        %h2!= devt_h2_quick
        %pre
          %code
            :preserve
              # Fresh clone → first build (PWMP7, no gyro, English WebUI)
              cd src/html && nvm use 20 && I18N_LOCALES=en npm run build:pteronautos
              cd ../.. && cd src && pio run -e PteronautOS_ESP8285_2400_RX

              # Build with gyro self-level
              pio run -e PteronautOS_ESP8285_2400_RX_HORIZON

              # Build PWMP5
              pio run -e PteronautOS_ESP8285_2400_RX_PWMP5

              # Inspect the full target list
              pio run --list-targets
        %p
          != devt_quick_outro_a
          %a{href: "#{asset_prefix}#{lang_dir}tutorials/flash-script/"}!= devt_quick_outro_link
          != devt_quick_outro_rest
    %footer
      .lang-switch
        %a{href: sub_lang_href_pt, class: sub_lang_class_pt} PT
        %a{href: sub_lang_href_en, class: sub_lang_class_en} EN
        %a{href: sub_lang_href_es, class: sub_lang_class_es} ES
        %a{href: sub_lang_href_fr, class: sub_lang_class_fr} FR
        %a{href: sub_lang_href_de, class: sub_lang_class_de} DE
        %a{href: sub_lang_href_ru, class: sub_lang_class_ru} RU
        %a{href: sub_lang_href_ko, class: sub_lang_class_ko} 한국어
        %a{href: sub_lang_href_ja, class: sub_lang_class_ja} 日本語
        %a{href: sub_lang_href_zh, class: sub_lang_class_zh} 中文
        %a{href: sub_lang_href_ar, class: sub_lang_class_ar} عربي
        %a{href: sub_lang_href_hi, class: sub_lang_class_hi} हिन्दी
      %p.footer-links
        %a.ext-link{href: "https://github.com/dantiel/PteronautOS", target: "_blank", rel: "noopener"}!= footer_github
        %span.sep ·
        %a{href: "#{asset_prefix}#{lang_dir}documentation/"}!= nav_documentation
        %span.sep ·
        %a{href: "#{asset_prefix}#{lang_dir}hardware/"}!= nav_hardware
        %span.sep ·
        %a{href: "#{asset_prefix}#{lang_dir}flasher/"}!= nav_flasher
        %span.sep ·
        %a.ext-link{href: "https://pteronaut.myspreadshop.de/", target: "_blank", rel: "noopener"}!= footer_store
      %p.credit!= footer_credit