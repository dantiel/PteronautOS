        %h2!= yos_h2_wiring
        %p!= yos_wiring_markdown
        %table
          %tr
            %th!= yos_wire_th1_html
            %th!= yos_wire_th2_html
            %th!= yos_wire_th3_html
          %tr
            %td BOOT (RX GPIO0)
            %td!= yos_wire_r1c2_html
            %td!= yos_wire_r1c3_html
          %tr
            %td 3V3
            %td!= yos_wire_r2c2_html
            %td!= yos_wire_r2c3_html
          %tr
            %td TX (CRSF out)
            %td!= yos_wire_r3c2_html
            %td!= yos_wire_r3c3_html
          %tr
            %td RX (CRSF in)
            %td!= yos_wire_r4c2_html
            %td!= yos_wire_r4c3_html
          %tr
            %td GND
            %td!= yos_wire_r5c2_html
            %td!= yos_wire_r5c3_html
        %pre
          %code
            :preserve
              S3 3V3   ──► S ── P-MOSFET (AO3401) ── D ──► EP2 3V3
              S3 GPIO10 ──► gate         (10kΩ pull-up to 3V3; LOW = ON)
              S3 GPIO9  ──► EP2 BOOT pad (asserted LOW during power-up)
              S3 GPIO18 ◄── EP2 TX       (U1 RX)
              S3 GPIO17 ──► EP2 RX       (U1 TX)
              S3 GND     ──► EP2 GND
        %aside.waveform-caution
          %strong!= yos_polarity_html
          %p!= yos_polarity_body_markdown

