!!!
%html{lang: lang, dir: dir}
  %head
    %meta{charset: "utf-8"}
    %meta{name: "viewport", content: "width=device-width, initial-scale=1"}
    %title!= wififlash_title
    %link{rel: "preconnect", href: "https://fonts.googleapis.com"}
    %link{rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: true}
    %link{rel: "stylesheet", href: "https://fonts.googleapis.com/css2?family=Turret+Road:wght@200;300;400;500;700;800&family=Noto+Naskh+Arabic:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@200;300;400;500;700&display=swap"}
    %link{rel: "stylesheet", href: "#{asset_prefix}assets/css/style.css"}
  %body.sub-page
    %nav.sub-nav
      .nav-progressive-blur{"aria-hidden": "true"}
        %span
        %span
        %span
        %span
      %button.nav-scroll-top{type: "button", onclick: "window.scrollTo({top:0,behavior:'smooth'})", "aria-label": subnav_scroll, title: subnav_scroll} ⬆
      %a.home-link{href: "#{asset_prefix}#{lang_dir}", title: subnav_home}
        %span.pteronaut> PTERONAUT
        %span.os OS
      %a{href: "#{asset_prefix}#{lang_dir}tutorials/", class: "active"}!= nav_tutorials
      %a{href: "#{asset_prefix}#{lang_dir}hardware/"}!= nav_hardware
      %a{href: "#{asset_prefix}#{lang_dir}documentation/"}!= nav_documentation
    %main.sub-main
      .sub-content
        %p.tutorial-number!= wififlash_number
        %h1!= wififlash_h1
        %p.sub-lead!= wififlash_lead

        %p!= wififlash_p1
        %p!= wififlash_p2

        %h2!= wififlash_h2_get
        %p!= wififlash_get_p
        %p.flasher-cta
          %a{href: "#{asset_prefix}assets/firmware/pteronaut-egg.bin", download: "pteronaut-egg.bin"}!= wififlash_download

        %h2!= wififlash_h2_flash
        %p!= wififlash_flash_p
        %p!= wififlash_stock_p
        %table
          %tr
            %th!= wififlash_th_ssid
            %th!= wififlash_th_value
          %tr
            %td!= wififlash_ssid_v
            %td
              %code ExpressLRS RX
          %tr
            %td!= wififlash_pass_v
            %td
              %code expresslrs
          %tr
            %td!= wififlash_host_v
            %td!= wififlash_page_stock
        %p!= wififlash_stock_note

        %h2!= wififlash_h2_getfull
        %p!= wififlash_getfull_p
        %p.flasher-cta
          %a{href: "#{asset_prefix}#{lang_dir}flasher/"}!= wififlash_download_full
        %p!= wififlash_getfull_note

        %h2!= wififlash_h2_connect
        %p!= wififlash_connect_p
        %table
          %tr
            %th!= wififlash_th_ssid
            %th!= wififlash_th_value
          %tr
            %td!= wififlash_ssid_v
            %td
              %code PTERONAUT-EGG
          %tr
            %td!= wififlash_pass_v
            %td
              %code hatchnatural
          %tr
            %td!= wififlash_host_v
            %td
              %code pteronaut-egg.local

        %h2!= wififlash_h2_upload
        %p!= wififlash_upload_p

        %h2!= wififlash_h2_update
        %p!= wififlash_update_p

        %h2!= wififlash_h2_wifi
        %p!= wififlash_wifi_p
        %table
          %tr
            %th!= wififlash_th_stage
            %th!= wififlash_th_ap
            %th!= wififlash_th_pw
            %th!= wififlash_th_page
          %tr
            %td!= wififlash_stage_stock
            %td
              %code ExpressLRS RX
            %td
              %code expresslrs
            %td!= wififlash_page_stock
          %tr
            %td!= wififlash_stage_egg
            %td
              %code PTERONAUT-EGG
            %td
              %code hatchnatural
            %td
              %code pteronaut-egg.local
          %tr
            %td!= wififlash_stage_full
            %td
              %code Pteronaut OS
            %td
              %code flynatural
            %td!= wififlash_page_full

        %h2!= wififlash_h2_risk
        %p!= wififlash_risk_p

        %aside.flasher-callout
          %p.flasher-callout-text!= wififlash_etcher_note
          %p.flasher-cta
            %a{href: "#{asset_prefix}#{lang_dir}flasher/"}!= wififlash_etcher_link

    %footer
      .lang-switch
        %a{href: sub_lang_href_pt, class: sub_lang_class_pt} PT
        %a{href: sub_lang_href_en, class: sub_lang_class_en} EN
        %a{href: sub_lang_href_es, class: sub_lang_class_es} ES
        %a{href: sub_lang_href_fr, class: sub_lang_class_fr} FR
        %a{href: sub_lang_href_de, class: sub_lang_class_de} DE
        %a{href: sub_lang_href_ru, class: sub_lang_class_ru} RU
        %a{href: sub_lang_href_ko, class: sub_lang_class_ko} 한국어
        %a{href: sub_lang_href_ja, class: sub_lang_class_ja} 日本語
        %a{href: sub_lang_href_zh, class: sub_lang_class_zh} 中文
        %a{href: sub_lang_href_ar, class: sub_lang_class_ar} العربية
        %a{href: sub_lang_href_hi, class: sub_lang_class_hi} हिन्दी
      %p.footer-links
        %a.ext-link{href: "https://github.com/dantiel/PteronautOS", target: "_blank", rel: "noopener"}!= footer_github
        %span.sep ·
        %a{href: "#{asset_prefix}#{lang_dir}documentation/"}!= nav_documentation
        %span.sep ·
        %a{href: "#{asset_prefix}#{lang_dir}hardware/"}!= nav_hardware
        %span.sep ·
        %a{href: "#{asset_prefix}#{lang_dir}flasher/"}!= nav_flasher
        %span.sep ·
        %a.ext-link{href: "https://pteronaut.myspreadshop.de/", target: "_blank", rel: "noopener"}!= footer_store
      %p.credit!= footer_credit