              %span= doc_wave_down
              %output{"data-value": "down", for: "st-wave-down-ferocity"} 8.0
              %input#st-wave-down-ferocity{"data-control": "down", type: "range", min: "0", max: "8", step: "0.1", value: "8"}
            .lock-ferocity
              .lock-lines
              %button#st-lock-ferocity{"data-control": "lock", type: "button", title: doc_lock_title, "aria-pressed": "false"}
                %svg.lock-icon{viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round"}
                  %path.shackle{d: "M7 11V7a5 5 0 0 1 10 0v4"}
                  %rect.body{x: "4", y: "11", width: "16", height: "10", rx: "2", fill: "none"}
              .lock-lines
            %label{for: "st-wave-up-ferocity"}
              %span= doc_wave_up
              %output{"data-value": "up", for: "st-wave-up-ferocity"} 0.0
              %input#st-wave-up-ferocity{"data-control": "up", type: "range", min: "0", max: "8", step: "0.1", value: "0"}
            %label{for: "st-wave-shape-mix"}
              %span= doc_wave_mix
              %output{"data-value": "mix", for: "st-wave-shape-mix"} 100%
              %input#st-wave-shape-mix{"data-control": "mix", type: "range", min: "0", max: "100", step: "1", value: "100"}
          .waveform-presets{"aria-label": doc_presets_label}
            %button{type: "button", "data-preset": "8,0,100"}= doc_preset_extreme
            %button{type: "button", "data-preset": "7,1,100"}= doc_preset_near
            %button{type: "button", "data-preset": "8,6,100"}= doc_preset_high
            %button{type: "button", "data-preset": "8,6,50"}= doc_preset_mixed
