!!!
%html{lang: lang, dir: dir}
  %head
    %meta{charset: "utf-8"}
    %meta{name: "viewport", content: "width=device-width, initial-scale=1"}
    %title!=st_title
    %link{rel: "preconnect", href: "https://fonts.googleapis.com"}
    %link{rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: true}
    %link{rel: "stylesheet", href: "https://fonts.googleapis.com/css2?family=Turret+Road:wght@200;300;400;500;700;800&family=Noto+Naskh+Arabic:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@200;300;400;500;700&display=swap"}
    %link{rel: "stylesheet", href: "#{asset_prefix}assets/css/style.css"}
    %script{src: "#{asset_prefix}assets/js/ferocity-waveform.js", defer: true}
  %body.sub-page
    %nav.sub-nav
      .nav-progressive-blur{"aria-hidden": "true"}
        %span
        %span
        %span
        %span
      %button.nav-scroll-top{type: "button", onclick: "window.scrollTo({top:0,behavior:'smooth'})", "aria-label": subnav_scroll, title: subnav_scroll} ↑
      %a.home-link{href: "#{asset_prefix}#{lang_dir}", title: subnav_home}
        %span.pteronaut> PTERONAUT
        %span.os OS
      %a{href: "#{asset_prefix}#{lang_dir}tutorials/"}!= nav_tutorials
      %a{href: "#{asset_prefix}#{lang_dir}hardware/"}!= nav_hardware
      %a{href: "#{asset_prefix}#{lang_dir}documentation/", class: "active"}!= nav_documentation
    %main.sub-main
      .sub-content
        %h1!=st_h1
        %p.sub-lead!= st_lead

        %h2!= st_h2_lineage
        %p
          !=st_lineage1a
          %a{href: "https://dantiel.github.io/OrniFlight/", target: "_blank"} OrniFlight
          != st_lineage1b
          %a{href: "https://dantiel.github.io/OrniFlight/en/wiki/servo_efficiency.html", target: "_blank"} servo-efficiency table
          != st_lineage1c
        %p!=st_lineage2

        %h2!= st_h2_pipeline
        %p!= st_pipeline
        %pre
          %code
            :preserve
              MPU6050 raw (I2C, 1 kHz register reads)
                ▼
              Zephyrus::update()            Mahony AHRS → roll°, pitch°, yawRate °/s
                ▼                            dual PID: roll→0°, pitch→0°, yawRate→0°/s
              4 raw pitch terms exposed      pitchPTerm · pitchITerm · pitchDTerm · pitchErrorRate
                ▼
              ZephyrusFilter.h (250 Hz)      copies terms onto ornithopter.gyroPitch*
                ▼
              Ornithopter::_computeServoMixer() / _computeGearboxMixer()
                ▼   Ondas P → phase · PD → dwell · I → asymmetry · SSFF → next stroke
              _f[]  →  funcMap → wing / crest-rudder / tail servos (µs)
        %p!=st_terms
        %pre
          %code
            :preserve
              pitchPTerm     = ZEPHYR_PID_PITCH_KP * pitchErr;                 // raw proportional
              pitchITerm     = _pidPitch.integrator;                           // accumulated error
              pitchDTerm     = ZEPHYR_PID_PITCH_KD * _pidPitch.lastDerivative; // low-pass filtered D
              pitchErrorRate = _pidPitch.lastDerivative;                       // °/s, for SSFF
        %p!=st_nan
        %table
          %tr
            %th!= st_bridge_th_field
            %th!= st_bridge_th_source
            %th!= st_bridge_th_consumed
          %tr
            %td
              %code gyroPitchPTerm
            %td
              %code pitchPTerm
            %td!= st_bridge_1
          %tr
            %td
              %code gyroPitchITerm
            %td
              %code pitchITerm
            %td!= st_bridge_2
          %tr
            %td
              %code gyroPitchDTerm
            %td
              %code pitchDTerm
            %td!= st_bridge_3
          %tr
            %td
              %code gyroPitchErrorRate
            %td
              %code pitchErrorRate
            %td!= st_bridge_4
          %tr
            %td
              %code gyroRudderCorrection
            %td
              %code rudderCorrection
            %td!=st_bridge_5
          %tr
            %td
              %code gyroAileronCorrection
            %td
              %code rollCorrection
              × gearbox gain
            %td!= st_bridge_6
          %tr
            %td
              %code gyroElevatorCorrection
            %td
              %code pitchCorrection
              × gain ×
              %code aeroGainScale
            %td!= st_bridge_7

        %h2!= st_h2_ondas
        %p!=st_ondas
        %h3!= st_h3_cadence
        %p!= st_cadence1
        %pre
          %code
            :preserve
              _osc.kGainMod = 1.0f + gyroPitchPTerm * aeroGainScale * cadenceGain * 0.00005f;
              // clamped to [0.5, 2.0] — phase can at most double or halve
        %p!=st_cadence2
        %h3!= st_h3_ferocity
        %p!= st_ferocity1
        %pre
          %code
            :preserve
              ferocitySignal = (gyroPitchPTerm * ferocityPGain * 0.00015f
                               + gyroPitchDTerm * ferocityDGain * 0.0003f) * aeroGainScale;
              // clamped to [-0.5, 0.5], added to both stroke and return ferocity
        %p!=st_ferocity2
        %h3!= st_h3_balance
        %p!= st_balance1
        %pre
          %code
            :preserve
              float iBias = gyroPitchITerm * aeroGainScale * balanceGain * 0.0001f;
              // clamped to [-3.0, 3.0]; added to strokeFer, subtracted from returnFer
        %p!=st_balance2
        %pre
          %code
            :preserve
              strokeFer = pilot(stroke) + ferocitySignal + iBias + _ssffFerocityUpBias
              returnFer = pilot(return) + ferocitySignal − iBias + _ssffFerocityDownBias

        %h2!=st_h2_shape
        %p!=st_shape
        %p!= doc_wave_p1
        %p!= doc_wave_p2
        %p!= doc_skew_p
        %p!= doc_throttle_skew_p
        %p!= doc_aileron_skew_p
        %p!= doc_slew_p
        %p!= doc_zephyr_slew_p

        #waveform-explorer.waveform-explorer.waveform-detailed{"data-ferocity-explorer": true, "data-i18n-lock-sync": doc_lock_sync, "data-i18n-lock-oppose": doc_lock_oppose, "data-i18n-lock-unlocked": doc_lock_unlocked, "data-i18n-axis-wing": doc_axis_wing, "data-i18n-axis-cycle": doc_axis_cycle, "data-i18n-axis-half": doc_axis_half, "data-i18n-metric": doc_metric}
          .waveform-controls
            %label{for: "st-wave-down-ferocity"}
              %span!= doc_wave_down
              %output{"data-value": "down", for: "st-wave-down-ferocity"} 8.0
              %input#st-wave-down-ferocity{"data-control": "down", type: "range", min: "0", max: "8", step: "0.1", value: "8"}
            .lock-ferocity
              .lock-lines
              %button#st-lock-ferocity{"data-control": "lock", type: "button", title: doc_lock_title, "aria-pressed": "false"}
                %svg.lock-icon{viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round"}
                  %path.shackle{d: "M7 11V7a5 5 0 0 1 10 0v4"}
                  %rect.body{x: "4", y: "11", width: "16", height: "10", rx: "2", fill: "none"}
              .lock-lines
            %label{for: "st-wave-up-ferocity"}
              %span!= doc_wave_up
              %output{"data-value": "up", for: "st-wave-up-ferocity"} 0.0
              %input#st-wave-up-ferocity{"data-control": "up", type: "range", min: "0", max: "8", step: "0.1", value: "0"}
            %label{for: "st-wave-shape-mix"}
              %span!= doc_wave_mix
              %output{"data-value": "mix", for: "st-wave-shape-mix"} 100%
              %input#st-wave-shape-mix{"data-control": "mix", type: "range", min: "0", max: "100", step: "1", value: "100"}
            %label{for: "st-wave-down-skew"}
              %span!= doc_wave_down_skew
              %output{"data-value": "skewDown", for: "st-wave-down-skew"} 0
              %input#st-wave-down-skew{"data-control": "skewDown", type: "range", min: "-100", max: "100", step: "1", value: "0"}
            %label{for: "st-wave-up-skew"}
              %span!= doc_wave_up_skew
              %output{"data-value": "skewUp", for: "st-wave-up-skew"} 0
              %input#st-wave-up-skew{"data-control": "skewUp", type: "range", min: "-100", max: "100", step: "1", value: "0"}
            %h4.waveform-subgroup!= doc_steering_label
            %label{for: "st-wave-throttle"}
              %span!= doc_wave_throttle
              %output{"data-value": "throttle", for: "st-wave-throttle"} 100%
              %input#st-wave-throttle{"data-control": "throttle", type: "range", min: "0", max: "100", step: "1", value: "100"}
            %label{for: "st-wave-aileron"}
              %span!= doc_wave_aileron
              %output{"data-value": "aileron", for: "st-wave-aileron"} 0
              %input#st-wave-aileron{"data-control": "aileron", type: "range", min: "-100", max: "100", step: "1", value: "0"}
            %label{for: "st-wave-throttle-skew-mix"}
              %span!= doc_wave_throttle_skew_mix
              %output{"data-value": "throttleSkewMix", for: "st-wave-throttle-skew-mix"} 0%
              %input#st-wave-throttle-skew-mix{"data-control": "throttleSkewMix", type: "range", min: "0", max: "100", step: "1", value: "0"}
            %label{for: "st-wave-aileron-skew-mix"}
              %span!= doc_wave_aileron_skew_mix
              %output{"data-value": "aileronSkewMix", for: "st-wave-aileron-skew-mix"} 0%
              %input#st-wave-aileron-skew-mix{"data-control": "aileronSkewMix", type: "range", min: "0", max: "100", step: "1", value: "0"}
            %label{for: "st-wave-slew"}
              %span!= doc_wave_slew
              %output{"data-value": "slew", for: "st-wave-slew"} 0
              %input#st-wave-slew{"data-control": "slew", type: "range", min: "-100", max: "100", step: "1", value: "0"}
          .waveform-presets{"aria-label": doc_presets_label}
            %button{type: "button", "data-preset": "8,0,100,0,0"}!= doc_preset_extreme
            %button{type: "button", "data-preset": "7,1,100,0,0"}!= doc_preset_near
            %button{type: "button", "data-preset": "8,6,100,0,0"}!= doc_preset_high
            %button{type: "button", "data-preset": "8,6,50,0,0"}!= doc_preset_mixed
            %button{type: "button", "data-preset": "6,6,100,50,50"}!= doc_preset_front
            %button{type: "button", "data-preset": "6,6,100,-50,-50"}!= doc_preset_late
          %p.waveform-metric{"data-waveform-metric": true, "aria-live": "polite"}
          .waveform-chart
            %h3!= doc_chart_whole
            .waveform-legend
              %span
                %i.current
                != doc_legend_current
              %span
                %i.direct
                != doc_legend_direct
              %span
                %i.boundary
                != doc_legend_reversal
              %span
                %i.wing-left
                != doc_legend_wing_l
              %span
                %i.wing-right
                != doc_legend_wing_r
            %svg{"data-chart": "cycle", role: "img", "aria-label": doc_chart_aria_cycle}
          .waveform-chart
            %h3!= doc_chart_halves
            .waveform-legend
              %span
                %i.down
                != doc_legend_down
              %span
                %i.up
                != doc_legend_up
              %span
                %i.direct
                != doc_legend_diagonal
              %span
                %i.wing-left
                != doc_legend_wing_l
              %span
                %i.wing-right
                != doc_legend_wing_r
            %svg{"data-chart": "halves", role: "img", "aria-label": doc_chart_aria_halves}
        %aside.waveform-caution
          %strong!= doc_caution_title
          != doc_caution_body
        %h3!= doc_read_h3
        %p!= doc_read_p

        %h2!= st_h2_anchor
        %p!= st_anchor1
        %pre
          %code
            :preserve
              kDamp = 10.0f + anchorGain;                  // anchorGain 0 → k₂=10 (tight)
              error = kGain * kGainMod * cadenceTarget
                    - kDamp * cadence;
        %p!=st_anchor2

        %h2!= st_h2_resonance
        %p!=st_resonance1
        %pre
          %code
            :preserve
              _resonanceAccum += gyroPitchErrorRate * sinf(_osc.phase)
                               * resonanceGain * 0.01f * dt;
              _resonanceAccum *= expf(-dt / 0.15f);        // leaky integrator, τ = 0.15 s
              clamp(_resonanceAccum, -2.0f, 2.0f);
        %p!=st_resonance2

        %h2!= st_h2_ssff
        %p!=st_ssff1
        %pre
          %code
            :preserve
              // zero-cross detected: finished one half-stroke, starting the next
              meanError = _ssffAccumError / count;
              bias      = meanError * ssffGain * 0.00001f;   // clamped ±2.0
              // upstroke just ended        → bias feeds the downstroke (power stroke)
              // downstroke just ended      → bias feeds the upstroke (recovery)
        %p!=st_ssff2

        %h2!= st_h2_aero
        %p!=st_aero1
        %pre
          %code
            :preserve
              aeroGainScale = isFlapping ? (aeroFlapCoeff  * 0.01f)
                                         : (aeroGlideCoeff * 0.01f);
        %p!=st_aero2
        %table
          %tr
            %th!= st_aero_th_coeff
            %th!= st_aero_th_default
            %th!= st_aero_th_range
            %th!= st_aero_th_when
          %tr
            %td
              %code aeroGlideCoeff
            %td 40
            %td 0–100
            %td!= st_aero_glide_when
          %tr
            %td
              %code aeroFlapCoeff
            %td 40
            %td 0–100
            %td!= st_aero_flap_when
        %p!=st_authority
        %table
          %tr
            %th!= st_auth_th_authority
            %th!= st_auth_th_servo
            %th!= st_auth_th_gear
          %tr
            %td!= st_auth_crest
            %td!= st_auth_crest_servo
            %td!= st_auth_crest_gear
          %tr
            %td!= st_auth_wing
            %td!= st_auth_wing_servo
            %td —
          %tr
            %td!= st_auth_leg
            %td —
            %td!= st_auth_leg_gear
          %tr
            %td!= st_auth_elevon
            %td —
            %td!=st_auth_elevon_gear
        %p!=st_lag

        %h2!=st_h2_webui
        %p!=st_webui1
        %pre
          %code
            :preserve
              {
                "ornithopter": {
                  "cadence_gain": 20.0, "ferocity_d_gain": 20.0, "balance_gain": 10.0,
                  "ferocity_p_gain": 0.0, "anchor_gain": 0.0, "resonance_gain": 0.0,
                  "ssff_gain": 0.0,
                  "aero_glide_coeff": 40.0, "aero_flap_coeff": 40.0,
                  "aero_gain_scale": 0.4
                }
              }
        %p!=st_webui2

        %h2!= st_h2_tuning
        %p!= st_tuning
        %ol
          %li!=st_tune_li1
          %li!=st_tune_li2
          %li!=st_tune_li3
          %li!=st_tune_li4
          %li!=st_tune_li5
          %li!=st_tune_li6
          %li!=st_tune_li7
          %li!=st_tune_li8
        %aside.waveform-caution
          %strong!= doc_caution_title
          != doc_caution_body

        %h2!=st_h2_status
        %p!=st_status_intro
        %pre
          %code
            :preserve
              // Ornithopter.cpp:269-275  (inside the flapping branch)
              #ifdef ZEPHYRUS_ENABLED
                  // STEP 7: ALL gyro values hard-zeroed (NaN guard test)
                  _osc.kGainMod = 1.0f;              // cadence channel OFF
                  gyroRudderCorrection  = 0.0f;      // crest rudder OFF while flapping
                  gyroAileronCorrection = 0.0f;
                  gyroElevatorCorrection= 0.0f;
              #endif
        %p!= st_status_p1
        %ul
          %li!=st_status_li1
          %li!=st_status_li2
          %li!=st_status_li3
        %p!=st_status_p2
        %p
          != st_status_final_a
          %a{href: "https://github.com/dantiel/PteronautOS/blob/master/docs/STABILIZATION.md", target: "_blank"} STABILIZATION.md
          != st_status_final_b
          %a{href: "https://dantiel.github.io/OrniFlight/", target: "_blank"} OrniFlight
          != st_status_final_c
    %footer
      .lang-switch
        %a{href: sub_lang_href_pt, class: sub_lang_class_pt} PT
        %a{href: sub_lang_href_en, class: sub_lang_class_en} EN
        %a{href: sub_lang_href_es, class: sub_lang_class_es} ES
        %a{href: sub_lang_href_fr, class: sub_lang_class_fr} FR
        %a{href: sub_lang_href_de, class: sub_lang_class_de} DE
        %a{href: sub_lang_href_ru, class: sub_lang_class_ru} RU
        %a{href: sub_lang_href_ko, class: sub_lang_class_ko} 한국어
        %a{href: sub_lang_href_ja, class: sub_lang_class_ja} 日本語
        %a{href: sub_lang_href_zh, class: sub_lang_class_zh} 中文
        %a{href: sub_lang_href_ar, class: sub_lang_class_ar} عربي
        %a{href: sub_lang_href_hi, class: sub_lang_class_hi} हिन्दी
      %p
        %a{href: "https://github.com/dantiel/PteronautOS", target: "_blank"}!= footer_github
      %p.credit!= footer_credit