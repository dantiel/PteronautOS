!!!
%html{lang: lang, dir: dir}
  %head
    %meta{charset: "utf-8"}
    %meta{name: "viewport", content: "width=device-width, initial-scale=1"}
    %title!= yo_title
    %link{rel: "preconnect", href: "https://fonts.googleapis.com"}
    %link{rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: true}
    %link{rel: "stylesheet", href: "https://fonts.googleapis.com/css2?family=Turret+Road:wght@200;300;400;500;700;800&family=Noto+Naskh+Arabic:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@200;300;400;500;700&display=swap"}
    %link{rel: "stylesheet", href: "#{asset_prefix}assets/css/style.css"}
    %script{src: "https://cdn.jsdelivr.net/npm/mermaid@10.9.1/dist/mermaid.min.js"}
    :javascript
      document.addEventListener('DOMContentLoaded', function () {
        mermaid.initialize({ startOnLoad: true, theme: 'dark', securityLevel: 'loose' });
      });
  %body.sub-page
    %nav.sub-nav
      .nav-progressive-blur{"aria-hidden": "true"}
        %span
        %span
        %span
        %span
      %button.nav-scroll-top{type: "button", onclick: "window.scrollTo({top:0,behavior:'smooth'})", "aria-label": subnav_scroll, title: subnav_scroll} ↑
      %a.home-link{href: "#{asset_prefix}#{lang_dir}", title: subnav_home}
        %span.pteronaut> PTERONAUT
        %span.os OS
      %a{href: "#{asset_prefix}#{lang_dir}tutorials/"}!= nav_tutorials
      %a{href: "#{asset_prefix}#{lang_dir}hardware/"}!= nav_hardware
      %a{href: "#{asset_prefix}#{lang_dir}documentation/", class: "active"}!= nav_documentation
    %main.sub-main
      .sub-content
        %h1!= yo_h1
        %p.sub-lead!= yo_lead

        %h2!= yo_h2_arch
        %p!= yo_arch_p1_markdown
        %p!= yo_arch_p2_markdown
        %pre.mermaid
          :preserve
            graph TB
              SKETCH["yoshimitsu.ino<br/>the relaxed sketch — config only"]
              LOADOUT["Yoshimitsu_Loadout.h<br/>the starting loadout · *_DEFAULT"]
              CORE["src/Yoshimitsu.h<br/>the whole core"]
              STANCES["six stances<br/>KINCHO · MANJI · FLEA<br/>MEDITATION · NSS · BACK"]
              CONSOLE["USB-serial console<br/>極光-gated admin"]
              CRSF["CRSF RX"]
              BRIDGE["MUSHIN bridge<br/>無心 no-mind protocol"]
              PWM["servo PWM<br/>wing L/R · crest"]
              SKETCH --> CORE
              LOADOUT --> CORE
              CRSF --> CORE
              BRIDGE --> CORE
              CONSOLE --> CORE
              CORE --> STANCES
              STANCES --> PWM

        %h2!= yo_h2_stances
        %p!= yo_stance_intro_markdown
        %table
          %tr
            %th!= yo_th_stance
            %th!= yo_th_duty
          %tr
            %td
              %code KINCHO
            %td!= yo_stance_kincho_markdown
          %tr
            %td
              %code MANJI_DRAGONFLY
            %td!= yo_stance_manji_markdown
          %tr
            %td
              %code FLEA
            %td!= yo_stance_flea_markdown
          %tr
            %td
              %code MEDITATION
            %td!= yo_stance_meditation_markdown
          %tr
            %td
              %code NSS
            %td!= yo_stance_nss_markdown
          %tr
            %td
              %code BACK_TURNED
            %td!= yo_stance_back_markdown

        %h2!= yo_h2_gates
        %p!= yo_gates_p1_markdown
        %ul
          %li!= yo_gate_jiguang_html
          %li!= yo_gate_gyro_html
          %li!= yo_gate_rgb_html
          %li!= yo_gate_prompt_html
          %li!= yo_gate_board_html

        %h2!= yo_h2_console
        %p!= yo_console_p1_markdown
        %p!= yo_console_p2_markdown

        %h2!= yo_h2_mushin
        %p!= yo_mushin_p1_markdown
        %pre
          %code
            :preserve
              [0x9B][len][type][payload][xor]
                0x01  INTENT    n × uint16 µs per servo
                0x02  ANNOUNCE  1 Hz keepalive
                0x03  TELEMETRY gyro rate + correction

        %h2!= yo_h2_deploy
        %p!= yo_deploy_p1_markdown

        %h2!= yo_h2_trouble
        %ul
          %li!= yo_trouble_li1_markdown
          %li!= yo_trouble_li2_markdown
          %li!= yo_trouble_li3_markdown

    %footer
      .lang-switch
        %a{href: sub_lang_href_pt, class: sub_lang_class_pt} PT
        %a{href: sub_lang_href_en, class: sub_lang_class_en} EN
        %a{href: sub_lang_href_es, class: sub_lang_class_es} ES
        %a{href: sub_lang_href_fr, class: sub_lang_class_fr} FR
        %a{href: sub_lang_href_de, class: sub_lang_class_de} DE
        %a{href: sub_lang_href_ru, class: sub_lang_class_ru} RU
        %a{href: sub_lang_href_ko, class: sub_lang_class_ko} 한국어
        %a{href: sub_lang_href_ja, class: sub_lang_class_ja} 日本語
        %a{href: sub_lang_href_zh, class: sub_lang_class_zh} 中文
        %a{href: sub_lang_href_ar, class: sub_lang_class_ar} عربي
        %a{href: sub_lang_href_hi, class: sub_lang_class_hi} हिन्दी
      %p
        %a{href: "https://github.com/dantiel/PteronautOS", target: "_blank"}!= footer_github
      %p.credit!= footer_credit
