!!!
%html{lang: lang, dir: dir}
  %head
    %meta{charset: "utf-8"}
    %meta{name: "viewport", content: "width=device-width, initial-scale=1"}
    %title!= mix_title
    %link{rel: "preconnect", href: "https://fonts.googleapis.com"}
    %link{rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: true}
    %link{rel: "stylesheet", href: "https://fonts.googleapis.com/css2?family=Turret+Road:wght@200;300;400;500;700;800&family=Noto+Naskh+Arabic:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@200;300;400;500;700&display=swap"}
    %link{rel: "stylesheet", href: "#{asset_prefix}assets/css/style.css"}
  %body.sub-page
    %nav.sub-nav
      .nav-progressive-blur{"aria-hidden": "true"}
        %span
        %span
        %span
        %span
      %button.nav-scroll-top{type: "button", onclick: "window.scrollTo({top:0,behavior:'smooth'})", "aria-label": subnav_scroll, title: subnav_scroll} ↑
      %a.home-link{href: "#{asset_prefix}#{lang_dir}", title: subnav_home}
        %span.pteronaut> PTERONAUT
        %span.os OS
      %a{href: "#{asset_prefix}#{lang_dir}tutorials/"}!= nav_tutorials
      %a{href: "#{asset_prefix}#{lang_dir}hardware/"}!= nav_hardware
      %a{href: "#{asset_prefix}#{lang_dir}documentation/", class: "active"}!= nav_documentation
    %main.sub-main
      .sub-content
        %h1!= mix_h1
        %p.sub-lead!= mix_lead

        %p
          !=mix_p1a
          %a{href: "#{asset_prefix}#{lang_dir}documentation/architecture/"}!= mix_link_arch
          != mix_p1b
          %a{href: "#{asset_prefix}#{lang_dir}documentation/servo-kernel/"}!= mix_link_servokernel
          != mix_p1c

        %h2!= mix_h2_tags
        %p!=mix_p3_tags_intro
        %table
          %tr
            %th!= mix_th_tag
            %th!= mix_th_name
            %th!= mix_th_meaning
          %tr
            %td
              %code 0
            %td
              %code SF_NONE
            %td!= mix_meaning_none
          %tr
            %td
              %code 1 / 2
            %td
              %code SF_LEFT_WING / SF_RIGHT_WING
            %td!= mix_meaning_wing
          %tr
            %td
              %code 3
            %td
              %code SF_RUDDER
            %td!= mix_meaning_rudder
          %tr
            %td
              %code 4
            %td
              %code SF_MOTOR
            %td!= mix_meaning_motor
          %tr
            %td
              %code 5 / 6
            %td
              %code SF_VTAIL_LEFT / SF_VTAIL_RIGHT
            %td!= mix_meaning_vtail
          %tr
            %td
              %code 7
            %td
              %code SF_ELEVATOR
            %td!= mix_meaning_elevator
          %tr
            %td
              %code 8 / 9
            %td
              %code SF_BACK_LEFT_WING / SF_BACK_RIGHT_WING
            %td!= mix_meaning_backwing
        %p!=mix_p3

        %h2!= mix_h2_profiles
        %p!=mix_p4_intro
        %table
          %tr
            %th #
            %th!= mix_th_prof
            %th!= mix_th_kernel
            %th!= mix_th_servos
            %th funcMap (PWM 3 · 4 · 5)
          %tr
            %td
              %code 0
            %td
              %code SERVO_2WING
            %td!= mix_kernel_wave
            %td 2
            %td!= mix_fm_row0
          %tr
            %td
              %code 1
            %td
              %code SERVO_2WING_1RUD
            %td!= mix_kernel_wave
            %td 3
            %td!= mix_fm_row1
          %tr
            %td
              %code 2
            %td
              %code SERVO_4WING
            %td!= mix_kernel_wave
            %td!= mix_servo4
            %td!= mix_fm_row2
          %tr
            %td
              %code 3
            %td
              %code GEARBOX_2VTAIL_1RUD
            %td!= mix_kernel_gear
            %td 3
            %td!= mix_fm_row3
          %tr
            %td
              %code 4
            %td
              %code GEARBOX_1MOT_2VTAIL
            %td!= mix_kernel_gear
            %td 3
            %td!= mix_fm_row4
          %tr
            %td
              %code 5
            %td
              %code GEARBOX_1MOT_2VTAIL_1RUD
            %td!= mix_kernel_gear
            %td!= mix_servo4b
            %td!= mix_fm_row5
          %tr
            %td
              %code 6
            %td
              %code GEARBOX_1ELE_1RUD
            %td!= mix_kernel_gear
            %td 2
            %td!= mix_fm_row6
          %tr
            %td
              %code 7
            %td
              %code GEARBOX_1MOT_1ELE_1RUD
            %td!= mix_kernel_gear
            %td 3
            %td!= mix_fm_row7
        %p!=mix_p4

        %h2!= mix_h2_wing
        %p!=mix_p5
        %p!=mix_p6
        %pre
          %code
            :preserve
              angleLeft  = NEUTRAL + (aileron + elevator + flapCentre − degL) · 2
              angleRight = NEUTRAL + (aileron − elevator − flapCentre + degR) · 2

              flapping:  degL/R = amplitudeL/R · shapedWave(rawPhase, ferocityL/R, …)
              glide:     degL = degR = 0 → static glide offset takes over
        %p!=mix_p7
        %ul
          %li!=mix_li1
          %li!=mix_li2
        %p!=mix_p8

        %h2!= mix_h2_rudder
        %p!=mix_p9
        %pre
          %code
            :preserve
              mix  = rudderNorm · rudderYawWeight  +  aileronNorm · rudderRollWeight
              mix  = clamp(mix, −1 … +1)
              µs   = 1500 + mix · 500            (rudder centre ± 500 µs)
                     + gyroRudderCorrection       (Zephyrus, when enabled)
                     + servoTrimUs[SF_RUDDER]
        %p!=mix_p10

        %h2!=mix_h2_gearbox
        %p!= mix_p11
        %ul
          %li!=mix_gb1
          %li!=mix_gb2
          %li!=mix_gb3
        %pre
          %code
            :preserve
              VtailLeft  = 1500 + (aileron + elevator)·scale + rollPID + pitchPID + trimL
              VtailRight = 1500 + (aileron − elevator)·scale − rollPID + pitchPID + trimR
              scale = 500 µs;  both aileron/elevator sums clamped to −1…+1 first
        %p!=mix_p12

        %h2!=mix_h2_gyro
        %p!= mix_p13
        %table
          %tr
            %th!= mix_th_axis
            %th!= mix_th_wavek
            %th!= mix_th_geark
          %tr
            %td!= mix_gyro_rudder
            %td!=mix_gyro_rudder_wave
            %td!=mix_gyro_rudder_gear
          %tr
            %td!= mix_gyro_roll
            %td!= mix_gyro_roll_wave
            %td!=mix_gyro_roll_gear
          %tr
            %td!= mix_gyro_pitch
            %td!= mix_gyro_pitch_wave
            %td!=mix_gyro_pitch_gear
        %p!=mix_p14

        %p
          != mix_p15a
          %a{href: "#{asset_prefix}#{lang_dir}tutorials/waveform-tuning/"}!= mix_link_waveform
          != mix_p15b
          %a{href: "#{asset_prefix}#{lang_dir}documentation/architecture/"}!= mix_link_arch2
          != mix_p15c
    %footer
      .lang-switch
        %a{href: sub_lang_href_pt, class: sub_lang_class_pt} PT
        %a{href: sub_lang_href_en, class: sub_lang_class_en} EN
        %a{href: sub_lang_href_es, class: sub_lang_class_es} ES
        %a{href: sub_lang_href_fr, class: sub_lang_class_fr} FR
        %a{href: sub_lang_href_de, class: sub_lang_class_de} DE
        %a{href: sub_lang_href_ru, class: sub_lang_class_ru} RU
        %a{href: sub_lang_href_ko, class: sub_lang_class_ko} 한국어
        %a{href: sub_lang_href_ja, class: sub_lang_class_ja} 日本語
        %a{href: sub_lang_href_zh, class: sub_lang_class_zh} 中文
        %a{href: sub_lang_href_ar, class: sub_lang_class_ar} عربي
        %a{href: sub_lang_href_hi, class: sub_lang_class_hi} हिन्दी
      %p
        %a{href: "https://github.com/dantiel/PteronautOS", target: "_blank"}!= footer_github
      %p.credit!= footer_credit
