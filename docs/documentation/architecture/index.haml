!!!
%html{lang: lang, dir: dir}
  %head
    %meta{charset: "utf-8"}
    %meta{name: "viewport", content: "width=device-width, initial-scale=1"}
    %title!=archart_title
    %link{rel: "preconnect", href: "https://fonts.googleapis.com"}
    %link{rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: true}
    %link{rel: "stylesheet", href: "https://fonts.googleapis.com/css2?family=Turret+Road:wght@200;300;400;500;700;800&family=Noto+Naskh+Arabic:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@200;300;400;500;700&display=swap"}
    %link{rel: "stylesheet", href: "#{asset_prefix}assets/css/style.css"}
  %body.sub-page
    %nav.sub-nav
      .nav-progressive-blur{"aria-hidden": "true"}
        %span
        %span
        %span
        %span
      %button.nav-scroll-top{type: "button", onclick: "window.scrollTo({top:0,behavior:'smooth'})", "aria-label": subnav_scroll, title: subnav_scroll} ↑
      %a.home-link{href: "#{asset_prefix}#{lang_dir}", title: subnav_home}
        %span.pteronaut> PTERONAUT
        %span.os OS
      %a{href: "#{asset_prefix}#{lang_dir}tutorials/"}= nav_tutorials
      %a{href: "#{asset_prefix}#{lang_dir}hardware/"}= nav_hardware
      %a{href: "#{asset_prefix}#{lang_dir}documentation/", class: "active"}= nav_documentation
    %main.sub-main
      .sub-content
        %h1!=archart_h1
        %p.sub-lead!=archart_lead

        %h2!=archart_h2_pipeline
        %p!=archart_p1
        %pre
          %code
            :preserve
              CRSF radio link
                │  2.4 GHz SX1280
                ▼
              rx_main / CRSF decoder        → ChannelData[]  (raw 172…1811 µs-window values)
                ▼
              Ornithopter::update()          → _readChannels() → voice* fields
                ▼  kernel select: activeProfile ≥ GEARBOX_2VTAIL_1RUD ?
              _computeServoMixer()   OR   _computeGearboxMixer()
                ▼
              _f[]  (indexed by ServoFunc tag, µs)
                ▼
              PWM output stage               → funcMap channels → wing / rudder / motor servos
        %p!=archart_p2
        %ol
          %li!=archart_li1
          %li
            !=archart_li2a
            %a{href: "#{asset_prefix}#{lang_dir}documentation/mixers/"}= archart_ref_mixers
            !=archart_li2b
          %li!=archart_li3
          %li!=archart_li4

        %h2!=archart_h2_kernels
        %p!=archart_p3
        %table
          %tr
            %th= archart_th_family
            %th= archart_th_profiles
            %th= archart_th_actuators
            %th= archart_th_model
          %tr
            %td!=archart_td_wave
            %td 0 SERVO_2WING · 1 SERVO_2WING_1RUD · 2 SERVO_4WING
            %td= archart_td_wave_act
            %td= archart_td_wave_model
          %tr
            %td!=archart_td_gear
            %td 3 GEARBOX_2VTAIL_1RUD · 4 GEARBOX_1MOT_2VTAIL · 5 GEARBOX_1MOT_2VTAIL_1RUD · 6 GEARBOX_1ELE_1RUD · 7 GEARBOX_1MOT_1ELE_1RUD
            %td= archart_td_gear_act
            %td= archart_td_gear_model
        %p!=archart_p4

        %h2!=archart_h2_servo
        %p!=archart_p5
        %ul
          %li!=archart_li5
          %li!=archart_li6
          %li!=archart_li7
          %li!=archart_li8
          %li!=archart_li9
          %li!=archart_li10
          %li!=archart_li11

        %h2!=archart_h2_gearbox
        %p!=archart_p6
        %ul
          %li!=archart_gb1
          %li!=archart_gb2
          %li!=archart_gb3
          %li!=archart_gb4
        %p!=archart_p7

        %h2!=archart_h2_state
        %p!=archart_p8
        %table
          %tr
            %th= archart_th_state
            %th= archart_th_cond
            %th= archart_th_behaviour
          %tr
            %td= archart_st1
            %td!=archart_st1c
            %td!=archart_st1b
          %tr
            %td= archart_st2
            %td!=archart_st2c
            %td!=archart_st2b
          %tr
            %td= archart_st3
            %td!=archart_st3c
            %td!=archart_st3b
          %tr
            %td= archart_st4
            %td!=archart_st4c
            %td!=archart_st4b
        %p!=archart_p9

        %h2!=archart_h2_map
        %table
          %tr
            %th= archart_th_module
            %th= archart_th_path
            %th= archart_th_resp
          %tr
            %td= archart_m1
            %td
              %code src/lib/Ornithopter/
            %td!=archart_m1r
          %tr
            %td!=archart_m2
            %td
              %code src/lib/Ornithopter/OrnithopterConfig.h
            %td!=archart_m2r
          %tr
            %td= archart_m3
            %td
              %code src/lib/Ornithopter/OrnithopterWaveform.h
            %td!=archart_m3r
          %tr
            %td= archart_m4
            %td
              %code src/lib/Zephyrus/
            %td!=archart_m4r
          %tr
            %td= archart_m5
            %td
              %code src/lib/ServoOutput/devServoOutput.cpp
            %td!=archart_m5r
          %tr
            %td= archart_m6
            %td
              %code src/lib/WIFI/devWIFI.cpp
            %td!=archart_m6r
        %p
          !=archart_p11
          %a{href: "#{asset_prefix}#{lang_dir}documentation/mixers/"}= archart_ref_mixers
          !=archart_p11b
          %a{href: "#{asset_prefix}#{lang_dir}documentation/servo-kernel/"}= archart_ref_servokernel
          !=archart_p11c
    %footer
      .lang-switch
        %a{href: sub_lang_href_pt, class: sub_lang_class_pt} PT
        %a{href: sub_lang_href_en, class: sub_lang_class_en} EN
        %a{href: sub_lang_href_es, class: sub_lang_class_es} ES
        %a{href: sub_lang_href_fr, class: sub_lang_class_fr} FR
        %a{href: sub_lang_href_de, class: sub_lang_class_de} DE
        %a{href: sub_lang_href_ru, class: sub_lang_class_ru} RU
        %a{href: sub_lang_href_ko, class: sub_lang_class_ko} 한국어
        %a{href: sub_lang_href_ja, class: sub_lang_class_ja} 日本語
        %a{href: sub_lang_href_zh, class: sub_lang_class_zh} 中文
        %a{href: sub_lang_href_ar, class: sub_lang_class_ar} عربي
        %a{href: sub_lang_href_hi, class: sub_lang_class_hi} हिन्दी
      %p
        %a{href: "https://github.com/dantiel/PteronautOS", target: "_blank"}= footer_github
      %p.credit= footer_credit
